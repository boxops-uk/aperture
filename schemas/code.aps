# The built-in code index — three layers, and the joins between them are the point.
#
# This file *is* the schema. It was twenty-two predicates of hand-written Rust until
# Phase 8; the parser reads it now, which is what makes a schema something a person can
# write rather than something the binary was compiled with.
#
# **Field order is the key order, and the key order is the index design.** A query can
# narrow on a leading run of a record's fields and only filter on the rest, so where a
# field sits decides what is fast. Two of these were once alphabetical by habit and cost
# 56,274 rows examined per row produced on an ordinary join — see `bench/FINDINGS.md` §2.
# Read each record as "what is this predicate fast at", not as a list of attributes.

schema src {

  # ---- the source layer -------------------------------------------------------
  #
  # What a syntax walk can see. `example/index.py` fills exactly these six with
  # Python's `ast`; everything below them needs a compiler and a build system.

  # A path, relative to the index root.
  predicate File : string

  # The **namespace**, per file. A file declaring two namespaces is two modules: the
  # C# analogue of a Python module is not the project, because a project spans
  # namespaces and a namespace spans projects.
  predicate Module : { file : File, name : string }

  # Declared `{module, name, line}`, and the line goes last on purpose: the join
  # anybody writes is "the declarations in this module", often narrowed by name, and
  # the line is what distinguishes two declarations that agree on both.
  #
  # The value side is the declaration's *kind* — `def`, `class`, `method` — because it
  # is the one thing a query wants to read without matching on, and a value cannot be
  # matched (I6).
  predicate Decl : { module : Module, name : string, line : int } -> string

  # **Where a declaration's name starts, and where the whole thing ends.**
  #
  # A key of one reference plus the span, in the shape `src.TypeOf` and `src.Doc` use —
  # an attribute *of* something else. It is not folded into `src.Decl` because that
  # would change what a declaration *is*: the key is the identity, every reference is a
  # `FactId` to it, and widening an identity to carry a rendering detail is how a schema
  # acquires fields nobody can explain later.
  #
  # `line` is the declaration's, from its key. `col` is where the **name** starts, so a
  # viewer can highlight the identifier rather than the statement; `endLine`/`endCol`
  # close the whole declaration, which is what folds a body.
  predicate DeclSpan : { decl : Decl, col : int, endLine : int, endCol : int }

  # **The search index over declaration names**, and the one predicate here that exists
  # for a reason about *keys* rather than about the code. A declaration's key begins
  # with its module, so `src.Decl {name = "encode"..}` reaches the name only after the
  # scan has opened. Keyed with the name leading, the same prefix is a range.
  #
  # It is the same names twice over, which is what a *derived* predicate is: data a
  # query could compute, stored keyed the way the query wants to read it. Written by
  # hand until Phase 8b can declare one.
  predicate SearchByName : { name : string, to : Decl }

  # **The same index, lower-cased**, because a search box is case-insensitive and focus
  # has no `toLower` to apply one at read time. A caller lower-cases the term and seeks
  # here; the rows still name the declaration, whose real name is on it.
  #
  # A *second* copy rather than a replacement: "find exactly `Parse`" and "find anything
  # spelled like parse" are different questions, and a case-folded index cannot answer
  # the first.
  predicate SearchByLowerName : { name : string, to : Decl }

  # Declared `{to, file, at}`, because find-references is the question: "where is this
  # used" seeks only if the target leads. The file comes second so "this declaration's
  # uses in this file" narrows too, and it is a field of its own because `to` reaches
  # the file the *declaration* is in, which for a reference worth having is a different
  # one.
  # `at.length` is how many characters the reference spells, which is what a viewer
  # needs to draw a link over it. It is in the **key** rather than on the value side on
  # purpose: a key field is already in the register the scan is holding, where a value
  # is a point read per row (I6). It costs the seeks nothing because it trails, so every
  # prefix above still narrows exactly as it did.
  predicate Ref : { to : Decl, file : File, at : { line : int, col : int, length : int } }

  # **The same references, keyed by the file they are in** — the one question `src.Ref`
  # cannot answer, because a predicate leads with one field and find-references needs
  # that field to be the target.
  #
  # This is what a viewer asks once per file, and against `src.Ref` it was a scan of the
  # largest relational predicate in the index: 4.9M rows to find the few hundred in one
  # file. Position leads the rest of the key, so a file's references come back in the
  # order a renderer wants to splice them.
  #
  # The third predicate here that exists because a derived one cannot yet be declared —
  # `src.SearchByName` and `src.Implements`'s closure are the others.
  predicate FileXRef : { file : File, at : { line : int, col : int, length : int }, to : Decl }

  # module → module, deduped: what a name in this file resolved to, rather than what a
  # `using` or an `import` statement claimed.
  predicate Import : { from : Module, to : Module }

  # ---- the build layer: what compiled a file, and into what --------------------

  # A `.csproj` path, as a file is a path.
  predicate Project : string

  # An assembly name.
  predicate Assembly : string

  # The **crossing**: a project, a target framework, and the assembly the pair
  # produces.
  predicate Compilation : { assembly : Assembly, framework : string, project : Project }

  # Edges, which is how a many-to-many is said without arrays.
  predicate ProjectSource : { file : File, project : Project }
  predicate ProjectRef : { from : Project, to : Project }

  # A **compound identity** — a package is its name *and* its version, and neither
  # alone.
  predicate Package : { name : string, version : string }
  predicate PackageRef : { package : Package, project : Project }

  # ---- the declaration graph: what a syntax walk cannot see --------------------
  #
  # All four of these lead with the end of the edge you fan out *from*, which is the
  # seek. `{base, type}` makes "everything deriving from this" a seek; the other three
  # are the same choice made again.

  predicate Member : { container : Decl, member : Decl }
  predicate Extends : { base : Decl, type : Decl }
  predicate Implements : { iface : Decl, type : Decl }
  predicate Override : { base : Decl, member : Decl }

  # **The other direction**, for the question a symbol panel actually asks: given this
  # type, what does it derive from. `src.Extends` answers "who derives from *this*",
  # which is the fan-out worth a seek and the opposite of what a panel wants.
  predicate DerivesFrom : { type : Decl, base : Decl }

  # An `int` in the middle of a key, so a method's parameters come back in order.
  predicate Param : { decl : Decl, index : int, name : string } -> string

  # A key of one field, which is what an *attribute of something else* is.
  predicate TypeOf : { decl : Decl } -> string
  predicate Doc : { decl : Decl } -> string

  # A string leading the key, so `[Obsolete]` everywhere is a seek rather than a scan.
  predicate Attribute : { attribute : string, target : Decl }

  # And the other direction, for the same reason `src.DerivesFrom` exists: a panel asks
  # what *this* declaration is marked with.
  predicate AttributeOf : { target : Decl, attribute : string }

  # The **wide row**: a file's line table, one fact per line, the text on the value
  # side. The largest predicate by bytes and the second largest by count.
  predicate Line : { file : File, line : int } -> string

}
