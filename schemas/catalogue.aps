# The store root, declared as a predicate so a query can ask about it.
#
# **Virtual**: answered by whoever is running the query out of what it knows, rather
# than read from a keyspace. That makes it a property of the *server* and not of any
# database, which is why it is a file of its own rather than a block in `code.aps` — it
# is deliberately absent from the handshake fingerprint, from the copy embedded at
# create, and from every artifact's keyspaces. A client that has never heard of it
# connects exactly as before.
#
# Every field is a key field and there is no value side. A value cannot be matched on
# (I6), and a listing exists to be filtered — by name, by status, by how big something
# got. There is no storage here for the distinction to buy anything back: a virtual
# predicate's key is simply the tuple a query may ask about, and the order is the order
# a lookup narrows in.

schema aperture.db {

  predicate List : {
    name : string,
    instance : string,
    status : string,
    facts : int,
    bytes : int,
    created : string,
  }

  # **What the interning path has done, per database, since this server opened it.**
  #
  # Interning is resolve-or-create: a producer sends a reference as the whole target
  # fact, and the write path turns it into a `FactId` by finding what that key already
  # names or creating it. On a nested code index the vast majority of those resolves
  # find something — a single `src.File` is named by a hundred thousand facts — so the
  # question that decides the cost of an ingest is *how many of them touched the LSM*,
  # and these are the four numbers that answer it.
  #
  # `hits`/`misses` are the ingest lookup cache, which sits inside the same per-key
  # stripe as the exclusion. A hit resolved a reference without a read; a miss fell
  # through to the trees, which is what `keys` then counts. `entities` is the second
  # read — the stored value, needed only to tell a duplicate from a same-key-different-
  # value conflict, and skipped entirely for a key-only predicate. So a healthy ingest
  # has `hits` far above `misses`, `keys` near the count of *distinct* keys it touched
  # rather than the count of references to them, and `entities` at zero for most of this
  # schema.
  #
  # **Since open, and per server.** These are not stored anywhere and survive nothing:
  # a restarted server starts from zero, and a database this server never opened has no
  # row at all — a sealed one is opened and never interns, so its row reads zero. That
  # makes this a gauge on a *run*, which is what a measurement of an ingest wants.
  #
  # Reading it locks each stripe in turn, so it is a report and not a hot path: asking
  # per row of a query over a real predicate would put a statistics call in front of the
  # write path it is reporting on.
  predicate Interning : {
    name : string,
    instance : string,
    hits : int,
    misses : int,
    keys : int,
    entities : int,
  }

}
