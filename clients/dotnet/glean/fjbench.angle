# Glean translation of Fjord's built-in code schema (schemas/code.sigla).
#
# Purpose: an apples-to-apples corpus for benchmarking Glean against Fjord.
# Every predicate, every field, and -- critically -- every FIELD ORDER is
# preserved from code.sigla, because on both systems the record's field order is
# the key's byte order, and the leading run of key fields is what a seek can
# narrow on. Reordering a field here would silently change the index design and
# invalidate the comparison.
#
# Namespace: Fjord calls this block `schema src`. Glean ships its own
# `src.1` (glean/schema/source/src.angle) which also declares
# `predicate File : string`, so reusing `src` would collide the moment this is
# loaded next to Glean's corpus. The namespace is `fjbench` and the predicate
# names are otherwise identical, so `fjbench.Decl` <-> `src.Decl`.
#
# One type substitution, everywhere it appears:
#
#   Fjord `int`  ->  Glean `nat`
#
# Fjord's `int` is a signed i64 with a negative marker band; Glean's Angle
# has NO signed integer at all (NatTy/ByteTy/StringTy/... in
# glean/angle/Glean/Angle/Types.hs). Every `int` in code.sigla is a line, column,
# end-line, end-column, length or parameter index -- non-negative by
# construction, and Glean's own src.angle types exactly these as `nat`. So the
# substitution is sound FOR THE INDEXER CORPUS.
#
#
# It is NOT sound for Fjord's demo corpus, which deliberately writes a
# parameter at index -1 to exercise zigzag encoding
# (clients/dotnet/Boxops.Fjord.Demo/Program.cs). Do not benchmark against that
# corpus through this schema; a negative would be unrepresentable here.

schema fjbench.1 {

# ---- the source layer -------------------------------------------------------

# A path, relative to the index root.
predicate File : string

# The namespace, per file.
predicate Module : { file : File, name : string }

# Declared {module, name, line}; line trails so "declarations in this module",
# optionally narrowed by name, is a prefix seek. Value side is the kind.
predicate Decl : { module : Module, name : string, line : nat } -> string

# Where a declaration's name starts and where the whole thing ends.
predicate DeclSpan : { decl : Decl, col : nat, endLine : nat, endCol : nat }

# Search index over declaration names, keyed with the name leading so a term
# prefix is a range rather than a scan opened after the module.
predicate SearchByName : { name : string, to : Decl }

# The same index, lower-cased, for case-insensitive search.
predicate SearchByLowerName : { name : string, to : Decl }

# find-references: the target leads, so "where is this used" seeks.
predicate Ref : { to : Decl, file : File, at : { line : nat, col : nat, length : nat } }

# The same references keyed by containing file -- the one question Ref cannot
# answer, since a predicate leads with one field.
predicate FileXRef : { file : File, at : { line : nat, col : nat, length : nat }, to : Decl }

# module -> module, deduped: what a name actually resolved to.
predicate Import : { from : Module, to : Module }

# ---- the build layer --------------------------------------------------------

predicate Project : string

predicate Assembly : string

predicate Compilation : { assembly : Assembly, framework : string, project : Project }

predicate ProjectSource : { file : File, project : Project }
predicate ProjectRef : { from : Project, to : Project }

predicate Package : { name : string, version : string }
predicate PackageRef : { package : Package, project : Project }

# ---- the declaration graph --------------------------------------------------
#
# These lead with the end of the edge you fan out from -- that end is the seek.

predicate Member : { container : Decl, member : Decl }
predicate Extends : { base : Decl, type : Decl }
predicate Implements : { iface : Decl, type : Decl }
predicate Override : { base : Decl, member : Decl }

# The other direction, for a symbol panel: given this type, what it derives from.
predicate DerivesFrom : { type : Decl, base : Decl }

# nat in the middle of the key, so a method's parameters come back in order.
predicate Param : { decl : Decl, index : nat, name : string } -> string

# A key of one field: an attribute of something else.
predicate TypeOf : { decl : Decl } -> string
predicate Doc : { decl : Decl } -> string

# A string leading the key, so "[Obsolete] everywhere" is a seek.
predicate Attribute : { attribute : string, target : Decl }

# The other direction: what is this declaration marked with.
predicate AttributeOf : { target : Decl, attribute : string }

# The wide row: a file's line table, one fact per line, text on the value side.
predicate Line : { file : File, line : nat } -> string

}

# Resolve unversioned names, e.g. fjbench.Decl -> fjbench.Decl.1
schema all.1 : fjbench.1 {}
