<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- **The only packable project here.** Shared metadata is in
         `../Directory.Build.props`; what is specific to the package is below.

         The id carries the `Boxops.` prefix, which is reserved on nuget.org, while the
         assembly and namespace stay `Fjord.Client` — the code is named for the product,
         and the package for who publishes it. -->
    <!-- **net8.0 as well as net10.0**, because the reach is the point of publishing:
         net8.0 is the current LTS, and this library uses nothing newer than
         `BinaryPrimitives`, ranges and Unix sockets. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <IsPackable>true</IsPackable>
    <PackageId>Boxops.Fjord.Client</PackageId>
    <Description>A .NET client for Fjord DB, an embedded immutable fact database: construct facts, write them over the wire with references nested inline, and query them back. A second implementation of the protocol, sharing no code with the Rust one.</Description>
    <PackageTags>fjord;database;datalog;facts;immutable;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- The sources are fully XML-documented and none of it reached a consumer.
         `NoWarn` for CS1591 is deliberate rather than lazy: what is undocumented here is
         a handful of self-evident record members, and a warning per one of those would
         hide the ones that matter. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both travel *in* the package: nuget.org renders the readme as the package page,
         and a licence expression still wants the text alongside it. -->
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
